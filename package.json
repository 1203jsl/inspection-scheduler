    "electron": "^38.8.6",
    "esbuild": "^0.25.12",
    "typescript": "5.9",
    "vite": "^7.3.8",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@fontsource/noto-sans-kr": "^5.3.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
